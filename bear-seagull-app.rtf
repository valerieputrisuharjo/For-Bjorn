\
      document.getElementById('modalDateProposalDetails').innerHTML = `\
        <div class="font-bold text-pink-700 text-sm mb-0.5">"$\{escapeHtml(invite.activity)\}"</div>\
        <div class="text-slate-500">Proposed for: <b>$\{invite.targetDate\}</b></div>\
      `;\
\
      document.getElementById('modalDateQuestionBox').classList.remove('hidden');\
      document.getElementById('modalDateSuccessBox').classList.add('hidden');\
      document.getElementById('dateProposalModal').classList.remove('hidden');\
    \}\
\
    function closeDateProposalModal() \{\
      document.getElementById('dateProposalModal').classList.add('hidden');\
    \}\
\
    function dodgeModalNoButton() \{\
      noDodgeCount++;\
      const noBtn = document.getElementById('modalBtnDateNo');\
      const yesBtn = document.getElementById('modalBtnDateYes');\
      const feedback = document.getElementById('modalNoFeedbackText');\
\
      yesBtnScale += 0.22;\
      yesBtn.style.transform = `scale($\{Math.min(2.5, yesBtnScale)\})`;\
\
      const phrase = FUNNY_NO_EXCUSES[(noDodgeCount - 1) % FUNNY_NO_EXCUSES.length];\
      noBtn.innerText = phrase;\
      feedback.innerText = `Attempt #$\{noDodgeCount\}: "$\{phrase\}"`;\
\
      const randX = (Math.random() - 0.5) * 160;\
      const randY = (Math.random() - 0.5) * 70;\
      noBtn.style.transform = `translate($\{randX\}px, $\{randY\}px)`;\
    \}\
\
    function handleModalDateYes() \{\
      const invite = appData.dateInvites.find(i => i.id === activeInviteId);\
      if (invite) \{\
        invite.status = 'accepted';\
        saveStoredData(true);\
      \}\
\
      document.getElementById('modalDateQuestionBox').classList.add('hidden');\
      document.getElementById('modalDateSuccessBox').classList.remove('hidden');\
      document.getElementById('modalDateSuccessText').innerText = invite ? \
        `Official date locked: "$\{invite.activity\}" on $\{invite.targetDate\}!` : \
        `Official plans locked in: Food, zero alarms, and celebrating our reunion together.`;\
\
      showToast("Date officially confirmed! \uc0\u55358 \u56642 \u55357 \u56470 ");\
      if (typeof confetti === 'function') confetti(\{ particleCount: 80, spread: 80, origin: \{ y: 0.6 \} \});\
      renderHeaderAndSummary();\
      renderDateMeTab();\
    \}\
\
    function finishDateAcceptance() \{\
      closeDateProposalModal();\
      switchTab('dateGame');\
    \}\
\
    let activeCategory = 'all';\
\
    function renderIdeas() \{\
      const container = document.getElementById('ideasCardsGrid');\
      container.innerHTML = '';\
\
      const filtered = appData.ideas.filter(item => \{\
        if (activeCategory === 'all') return true;\
        return item.category === activeCategory;\
      \});\
\
      if (filtered.length === 0) \{\
        container.innerHTML = `<div class="col-span-3 text-center py-8 text-xs text-slate-400">No ideas in this category yet. Add one above!</div>`;\
        return;\
      \}\
\
      filtered.forEach(idea => \{\
        const card = document.createElement('div');\
        card.className = `p-4 rounded-3xl border transition flex flex-col justify-between $\{idea.checked ? 'bg-slate-50 border-slate-200 opacity-60' : 'bg-white border-pink-100 shadow-2xs'\}`;\
        card.innerHTML = `\
          <div class="space-y-1.5">\
            <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full $\{idea.category === 'Food' ? 'bg-orange-50 text-orange-700' : idea.category === 'Cozy' ? 'bg-pink-50 text-pink-700' : 'bg-emerald-50 text-emerald-700'\}">$\{idea.category\}</span>\
            <p class="text-xs font-semibold text-slate-800 $\{idea.checked ? 'line-through text-slate-400' : ''\}">$\{escapeHtml(idea.title)\}</p>\
          </div>\
          <div class="pt-3 flex items-center justify-between border-t border-slate-100 mt-2">\
            <button onclick="toggleIdeaCheck('$\{idea.id\}')" class="text-xs font-bold $\{idea.checked ? 'text-slate-400' : 'text-pink-600 hover:text-pink-700'\} flex items-center gap-1.5">\
              <i class="fa-$\{idea.checked ? 'solid fa-circle-check text-emerald-500' : 'regular fa-circle'\}"></i>\
              <span>$\{idea.checked ? 'Done' : 'Mark done'\}</span>\
            </button>\
            <button onclick="deleteIdea('$\{idea.id\}')" class="text-xs text-slate-300 hover:text-rose-500 p-1">\
              <i class="fa-regular fa-trash-can"></i>\
            </button>\
          </div>\
        `;\
        container.appendChild(card);\
      \});\
    \}\
\
    function filterIdeas(cat) \{\
      activeCategory = cat;\
      document.querySelectorAll('.idea-tag-btn').forEach(b => \{\
        if (b.dataset.cat === cat) \{\
          b.className = "idea-tag-btn px-3 py-1.5 rounded-full bg-slate-900 text-white font-bold";\
        \} else \{\
          b.className = "idea-tag-btn px-3 py-1.5 rounded-full bg-white text-slate-600 font-semibold border border-slate-200 hover:bg-pink-50";\
        \}\
      \});\
      renderIdeas();\
    \}\
\
    function openAddIdeaModal() \{\
      document.getElementById('newIdeaTitle').value = '';\
      document.getElementById('addIdeaModal').classList.remove('hidden');\
    \}\
\
    function closeAddIdeaModal() \{\
      document.getElementById('addIdeaModal').classList.add('hidden');\
    \}\
\
    function saveNewIdea() \{\
      const title = document.getElementById('newIdeaTitle').value.trim();\
      const category = document.getElementById('newIdeaCategory').value;\
\
      if (!title) \{\
        showToast("Please enter a date idea!");\
        return;\
      \}\
\
      appData.ideas.unshift(\{\
        id: 'idea-' + Date.now(),\
        title,\
        category,\
        checked: false\
      \});\
\
      saveStoredData(true);\
      closeAddIdeaModal();\
      renderIdeas();\
      renderHeaderAndSummary();\
      showToast("Date idea added! \uc0\u55357 \u56481 ");\
    \}\
\
    function toggleIdeaCheck(id) \{\
      const item = appData.ideas.find(i => i.id === id);\
      if (item) \{\
        item.checked = !item.checked;\
        saveStoredData(true);\
        renderIdeas();\
        renderHeaderAndSummary();\
      \}\
    \}\
\
    function deleteIdea(id) \{\
      appData.ideas = appData.ideas.filter(i => i.id !== id);\
      saveStoredData(true);\
      renderIdeas();\
      renderHeaderAndSummary();\
    \}\
\
    function openSettingsModal() \{\
      document.getElementById('settingHisName').value = appData.config.hisName;\
      document.getElementById('settingHerName').value = appData.config.herName;\
      document.getElementById('settingStartDate').value = appData.config.startDate;\
      document.getElementById('settingEndDate').value = appData.config.endDate;\
      document.getElementById('sharedRoomInput').value = currentRoomCode;\
      document.getElementById('settingsModal').classList.remove('hidden');\
    \}\
\
    function closeSettingsModal() \{\
      document.getElementById('settingsModal').classList.add('hidden');\
    \}\
\
    function saveRotationSettings() \{\
      const his = document.getElementById('settingHisName').value.trim() || 'Bj\'f6rn';\
      const her = document.getElementById('settingHerName').value.trim() || 'Valerie';\
      const start = document.getElementById('settingStartDate').value;\
      const end = document.getElementById('settingEndDate').value;\
\
      if (!start || !end) \{\
        showToast("Please pick both departure & return dates!");\
        return;\
      \}\
\
      if (new Date(end) <= new Date(start)) \{\
        showToast("Return date must be after departure date!");\
        return;\
      \}\
\
      appData.config.hisName = his;\
      appData.config.herName = her;\
      appData.config.startDate = start;\
      appData.config.endDate = end;\
\
      saveStoredData(true);\
      closeSettingsModal();\
      renderHeaderAndSummary();\
      showToast("Settings updated! \uc0\u9875 \u10024 ");\
    \}\
\
    function applyNewRoomCode() \{\
      const val = document.getElementById('sharedRoomInput').value.trim();\
      if (!val) return;\
      currentRoomCode = val.toLowerCase().replace(/[^a-z0-9_-]/g, '-');\
      localStorage.setItem('rotation_active_room', currentRoomCode);\
      appData = loadStoredData();\
      saveStoredData(true);\
      renderHeaderAndSummary();\
      showToast(`Connected to room: "$\{currentRoomCode\}"!`);\
    \}\
\
    function copyShareableUrl() \{\
      const base = window.location.origin + window.location.pathname;\
      const shareUrl = `$\{base\}?room=$\{encodeURIComponent(currentRoomCode)\}`;\
      \
      const textArea = document.createElement("textarea");\
      textArea.value = shareUrl;\
      textArea.style.position = "fixed";\
      document.body.appendChild(textArea);\
      textArea.focus();\
      textArea.select();\
\
      try \{\
        document.execCommand('copy');\
        showToast("WhatsApp link copied! Paste it to him \uc0\u55357 \u56562 ");\
      \} catch (err) \{\
        prompt("Copy this URL and send it to him:", shareUrl);\
      \}\
      document.body.removeChild(textArea);\
    \}\
\
    function exportDataBackup() \{\
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));\
      const downloadAnchor = document.createElement('a');\
      downloadAnchor.setAttribute("href", dataStr);\
      downloadAnchor.setAttribute("download", `rotation_capsule_$\{currentRoomCode\}_$\{new Date().toISOString().split('T')[0]\}.json`);\
      document.body.appendChild(downloadAnchor);\
      downloadAnchor.click();\
      downloadAnchor.remove();\
      showToast("Data backup saved to your device! \uc0\u55357 \u56513 ");\
    \}\
\
    function confirmResetDefaults() \{\
      if (confirm("Reset rotation demo data back to start?")) \{\
        localStorage.removeItem(getStorageKey());\
        appData = JSON.parse(JSON.stringify(DEFAULT_DATA));\
        saveStoredData(false);\
        location.reload();\
      \}\
    \}\
\
    function showToast(msg) \{\
      const el = document.getElementById('toastNotification');\
      document.getElementById('toastMessage').innerText = msg;\
      el.classList.remove('translate-y-24', 'opacity-0');\
      setTimeout(() => \{\
        el.classList.add('translate-y-24', 'opacity-0');\
      \}, 3000);\
    \}\
\
    function escapeHtml(text) \{\
      if (!text) return '';\
      return String(text)\
        .replace(/&/g, '&amp;')\
        .replace(/</g, '&lt;')\
        .replace(/>/g, '&gt;')\
        .replace(/"/g, '&quot;')\
        .replace(/'/g, '&#039;');\
    \}\
\
    window.addEventListener('DOMContentLoaded', () => \{\
      renderHeaderAndSummary();\
      try \{\
        if (typeof pullFromCloudRelay === 'function') \{\
          pullFromCloudRelay().catch(() => \{\});\
        \}\
      \} catch (e) \{\}\
    \});\
  </script>\
</body>\
</html>}