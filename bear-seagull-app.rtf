    <span id="toastMessage">Saved!</span>\
  </div>\
\
  <!-- FOOTER -->\
  <footer class="bg-white border-t border-pink-100 py-4 text-center text-xs text-slate-400">\
    <div class="max-w-4xl mx-auto px-4 flex flex-col items-center justify-center gap-1.5">\
      <p class="text-pink-600 font-medium italic">\
        Philippians 1:3 says, &ldquo;I thank my God every time I remember you,&rdquo;\
      </p>\
      <div class="flex items-center gap-3 text-slate-400 text-[11px] pt-1">\
        <span>Rotation Capsule \uc0\u9875  Built with love for sea rotations</span>\
        <span>\'95</span>\
        <button onclick="openSettingsModal()" class="hover:text-pink-600 font-semibold underline">Settings & Share</button>\
      </div>\
    </div>\
  </footer>\
\
  <script>\
    const DEFAULT_START_DATE = new Date(Date.now() - 5 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\
    const DEFAULT_END_DATE = new Date(Date.now() + 37 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\
\
    // Read room code from URL parameter if provided\
    const urlParams = new URLSearchParams(window.location.search);\
    let currentRoomCode = urlParams.get('room') || localStorage.getItem('rotation_active_room') || 'bjorn-valerie-sea';\
\
    const STORAGE_KEY_PREFIX = 'rotation_capsule_data_';\
    const DRAFT_KEY_PREFIX = 'rotation_capsule_draft_';\
\
    function getStorageKey() \{\
      return STORAGE_KEY_PREFIX + currentRoomCode;\
    \}\
\
    function getDraftKey() \{\
      return DRAFT_KEY_PREFIX + currentRoomCode;\
    \}\
\
    let logPendingDeletionId = null;\
\
    const DEFAULT_DATA = \{\
      roomCode: currentRoomCode,\
      lastUpdated: Date.now(),\
      config: \{\
        hisName: "Bj\'f6rn",\
        herName: "Valerie",\
        startDate: DEFAULT_START_DATE,\
        endDate: DEFAULT_END_DATE\
      \},\
      galleryPhotos: [\
        \{\
          id: 'gallery-1',\
          url: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=500&auto=format&fit=crop&q=60',\
          caption: 'Sunset across calm waves',\
          date: new Date().toISOString().split('T')[0]\
        \}\
      ],\
      dateInvites: [\
        \{\
          id: 'invite-demo-1',\
          activity: 'Homemade burgers, warm fries and cozy cuddle night',\
          targetDate: new Date(Date.now() + 38 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],\
          sender: 'Valerie',\
          status: 'pending',\
          createdAt: Date.now()\
        \}\
      ],\
      checkIns: [\
        \{\
          id: 'log-1',\
          date: new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],\
          dayNumber: 3,\
          mood: 'Cruising on good vibes \uc0\u10024 ',\
          missScale: 5,\
          missDesc: 'Ready to swim back across the ocean right now',\
          questionPrompt: 'What is the first thing we should eat when you get back on land?',\
          questionAnswer: 'Fresh burgers, warm fries and stroopwafels together!',\
          photoData: '',\
          message: 'Calm night on watch today. Stars look beautiful from the bridge!'\
        \}\
      ],\
      notes: [\
        \{\
          id: 'note-1',\
          day: 1,\
          title: 'First Day Aboard the Ship',\
          body: 'You just stepped on board! Drink lots of water, rest up after travel, and remember that every watch you finish is one step closer to home. Love you always!'\
        \},\
        \{\
          id: 'note-2',\
          day: 7,\
          title: 'Week 1 Complete! \uc0\u55356 \u57225 ',\
          body: 'First full week crushed! You got into your ship rhythm now. Sending you the biggest hug across the sea.'\
        \},\
        \{\
          id: 'note-3',\
          day: 21,\
          title: 'Halfway Mark Milestone',\
          body: 'Officially halfway through the rotation! Starting tomorrow, you are sailing on the downhill journey back to my arms.'\
        \}\
      ],\
      ideas: [\
        \{ id: 'idea-1', title: 'Late night ramen and warm gyozas in comfy clothes', category: 'Food', checked: false \},\
        \{ id: 'idea-2', title: 'Lazy Sunday couch day with zero morning alarms', category: 'Cozy', checked: false \},\
        \{ id: 'idea-3', title: 'Weekend bike trip along the harbor & canals', category: 'Outdoors', checked: false \}\
      ]\
    \};\
\
    let appData = loadStoredData();\
\
    function loadStoredData() \{\
      try \{\
        const raw = localStorage.getItem(getStorageKey());\
        if (raw) \{\
          const parsed = JSON.parse(raw);\
          if (parsed && parsed.config && parsed.checkIns && parsed.notes && parsed.ideas) \{\
            if (!parsed.dateInvites) parsed.dateInvites = [];\
            if (!parsed.galleryPhotos) parsed.galleryPhotos = [];\
            return parsed;\
          \}\
        \}\
      \} catch (e) \{\
        console.error('Local load failed:', e);\
      \}\
      return JSON.parse(JSON.stringify(DEFAULT_DATA));\
    \}\
\
    function saveStoredData(triggerRemoteSync = true) \{\
      appData.lastUpdated = Date.now();\
      try \{\
        localStorage.setItem(getStorageKey(), JSON.stringify(appData));\
        localStorage.setItem('rotation_active_room', currentRoomCode);\
      \} catch (e) \{\
        console.error('Local save failed:', e);\
      \}\
      if (triggerRemoteSync) \{\
        pushToCloudRelay();\
      \}\
    \}\
\
    async function pushToCloudRelay() \{\
      try \{\
        const payload = JSON.stringify(appData);\
        await fetch(`https://api.restful-api.dev/objects`, \{\
          method: 'POST',\
          headers: \{ 'Content-Type': 'application/json' \},\
          body: JSON.stringify(\{\
            name: `rotation_sync_$\{currentRoomCode\}`,\
            data: \{ payload: payload \}\
          \})\
        \}).catch(() => null);\
      \} catch (err) \{\
        console.warn('Offline mode active');\
      \}\
    \}\
\
    async function pullFromCloudRelay() \{\
      try \{\
        // Sync check helper for multi-device environments\
        console.log('Room sync active for:', currentRoomCode);\
      \} catch (e) \{\}\
    \}\
\
    function getRotationMetrics() \{\
      const start = new Date(appData.config.startDate + 'T00:00:00');\
      const end = new Date(appData.config.endDate + 'T00:00:00');\
      const today = new Date();\
      today.setHours(0, 0, 0, 0);\
\
      const totalDays = Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)));\
      const elapsedDays = Math.round((today - start) / (1000 * 60 * 60 * 24));\
      \
      const currentDay = Math.max(1, Math.min(totalDays, elapsedDays + 1));\
      const daysLeft = Math.max(0, Math.round((end - today) / (1000 * 60 * 60 * 24)));\
      const progressPercent = Math.min(100, Math.max(4, Math.round((currentDay / totalDays) * 100)));\
      const isCompleted = daysLeft <= 0;\
\
      return \{ totalDays, currentDay, daysLeft, progressPercent, isCompleted \};\
    \}\
\
    function renderHeaderAndSummary() \{\
      const metrics = getRotationMetrics();\
      const cfg = appData.config;\
\
      document.getElementById('headerNamesSubtitle').innerText = `$\{cfg.hisName\} & $\{cfg.herName\}`;\
      document.getElementById('greetingTitle').innerText = `Halo, $\{cfg.hisName\}! \uc0\u55357 \u56395 `;\
      document.getElementById('rotationDateRangeLabel').innerText = `$\{cfg.startDate\} \uc0\u8594  $\{cfg.endDate\}`;\
\
      document.getElementById('rotationProgressDayLabel').innerHTML = `\
        <span class="text-sm">\uc0\u55357 \u56787 \u65039 </span> Day $\{metrics.currentDay\} of $\{metrics.totalDays\} on Rotation\
      `;\
      \
      if (metrics.daysLeft > 0) \{\
        document.getElementById('daysRemainingLabel').innerText = `$\{metrics.daysLeft\} days left`;\
        document.getElementById('greetingCountdownSubtitle').innerText = `$\{metrics.daysLeft\} days until rotation ends and we're back meeting each other!!`;\
      \} else \{\
        document.getElementById('daysRemainingLabel').innerText = `Rotation Completed! \uc0\u55356 \u57225 `;\
        document.getElementById('greetingCountdownSubtitle').innerText = `Rotation is finished and you are finally back meeting each other!! \uc0\u55356 \u57225 `;\
      \}\
\
      document.getElementById('shipProgressBar').style.width = `$\{metrics.progressPercent\}%`;\
      document.getElementById('shipMarker').style.left = `$\{Math.min(96, Math.max(4, metrics.progressPercent))\}%`;\
\
      // Check for pending Date Invitation to highlight on Home\
      renderHomeDateInviteBanner();\
\
      // Today's Check-in Status Card\
      const todayStr = new Date().toISOString().split('T')[0];\
      const todayDone = appData.checkIns.some(ci => ci.date === todayStr);\
\
      const actionBox = document.getElementById('dailyCheckInActionBox');\
      const todayIcon = document.getElementById('statTodayIcon');\
      const todayText = document.getElementById('statTodayText');\
\
      if (todayDone) \{\
        todayIcon.className = "w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold";\
        todayIcon.innerHTML = "\uc0\u10003 ";\
        todayText.innerText = "Completed today \uc0\u10003 ";\
\
        actionBox.innerHTML = `\
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg mb-2">\
            <i class="fa-solid fa-check"></i>\
          </div>\
          <div class="text-xs font-bold text-slate-800">Day $\{metrics.currentDay\} Logged & Sealed!</div>\
          <p class="text-[11px] text-slate-500 mt-1">Saved in the capsule for our reunion together.</p>\
        `;\
      \} else \{\
        todayIcon.className = "w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold";\
        todayIcon.innerHTML = "\uc0\u9203 ";\
        todayText.innerText = "Pending today";\
\
        const hasSavedDraft = !!localStorage.getItem(getDraftKey());\
        actionBox.innerHTML = `\
          <div class="text-xs font-bold text-slate-800 mb-1">Today's Sea Check-in</div>\
          <p class="text-[11px] text-slate-500 mb-3">$\{hasSavedDraft ? 'Continue your in-progress check-in' : `Record Day $\{metrics.currentDay\} mood, photo & thoughts.`\}</p>\
          <button onclick="startDailyCheckIn()" class="w-full px-4 py-2.5 bg-gradient-to-r from-pink-500 to-ocean-500 hover:opacity-95 text-white text-xs font-bold rounded-xl shadow-xs transition">\
            $\{hasSavedDraft ? 'Continue Saved Draft \uc0\u9999 \u65039 ' : 'Start Daily Check-in'\}\
          </button>\
        `;\
      \}\
\
      document.getElementById('statTotalLogsText').innerText = `$\{appData.checkIns.length\} $\{appData.checkIns.length === 1 ? 'day' : 'days'\} logged`;\
      document.getElementById('statTotalIdeasText').innerText = `$\{appData.ideas.filter(i => !i.checked).length\} ideas ready`;\
\
      // Render home gallery photos\
      renderHomePhotoGallery();\
    \}\
\
    // Comprehensive list of daily rotating prompts\
    const ROTATION_PROMPTS = [\
      "What is the first meal or snack we must eat together when you're back?",\
      "What funny moment or joke happened on watch or in the galley today?",\
      "What memory of us recently popped up and made you smile?",\
      "Which movie, series, or documentary should we binge first during holiday?",\
      "If you could teleport to any spot on earth with me for 2 hours right now, where?",\
      "What is your favorite little thing about our morning or evening routines?",\
      "What comfort treat or drink do you want ready waiting in the fridge for you?",\
      "What song instantly reminds you of us when you listen to your headphones?",\
      "What is one funny habit of mine that you actually miss right now?",\
      "Describe our ideal first full day off together with zero alarms.",\
      "What was the most interesting or weirdest thing you saw at sea today?",\
      "If we were eating dinner together right now, what would we order?",\
      "What is your favorite memory from our previous holiday together?",\
      "What new place or cozy cafe do you want to explore during this break?",\
      "What is something simple you appreciate about our relationship?",\
      "What cozy outfit are you switching into the moment you step through our door?",\
      "If you could send a physical care package right now, what would be inside?",\
      "What inside joke between us makes you laugh out loud when you think of it?",\
      "What is the first outdoor walk or trip we should go on together?",\
      "Name 3 things you look forward to doing together during our upcoming 6 weeks holiday!"\
    ];\
\
    function getPromptForDay(dayNumber) \{\
      // Deterministic calculation based on calendar day or rotation day so both see the exact same question\
      const today = new Date();\
      const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));\
      const index = (dayNumber ? (dayNumber - 1) : dayOfYear) % ROTATION_PROMPTS.length;\
      return ROTATION_PROMPTS[Math.abs(index)];\
    \}\
\
    function renderHomePhotoGallery() \{\
      const grid = document.getElementById('homePhotoGalleryGrid');\
      if (!grid) return;\
      grid.innerHTML = '';\
\
      if (!appData.galleryPhotos || appData.galleryPhotos.length === 0) \{\
        grid.innerHTML = `\
          <div class="col-span-2 sm:col-span-3 md:col-span-4 text-center py-6 text-xs text-slate-400 bg-slate-50/70 border border-dashed border-slate-200 rounded-2xl">\
            <span class="text-lg block mb-1">\uc0\u55357 \u56567 </span>\
            No photos uploaded yet. Tap "Add Photo" above to pin your first memory!\
          </div>\
        `;\
        return;\
      \}\
\
      appData.galleryPhotos.slice().reverse().forEach(photo => \{\
        const item = document.createElement('div');\
        item.className = "group relative bg-white p-2 rounded-2xl border border-pink-100 shadow-2xs hover:shadow-xs transition overflow-hidden flex flex-col justify-between";\
        item.innerHTML = `\
          <div class="relative overflow-hidden rounded-xl bg-slate-100 aspect-square">\
            <img src="$\{photo.url\}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" alt="Memory">\
            <button onclick="deleteHomeGalleryPhoto('$\{photo.id\}')" title="Delete photo" class="absolute top-1.5 right-1.5 w-7 h-7 rounded-full bg-slate-900/70 hover:bg-rose-600 text-white flex items-center justify-center text-xs opacity-90 sm:opacity-0 group-hover:opacity-100 transition">\
              <i class="fa-solid fa-trash-can"></i>\
            </button>\
          </div>\
          <div class="pt-2 px-1 text-[11px] text-slate-600 truncate font-medium">\
            $\{escapeHtml(photo.caption || photo.date || 'Voyage memory')\}\
          </div>\
        `;\
        grid.appendChild(item);\
      \});\
    \}\
\
    function handleHomeGalleryPhotoUpload(e) \{\
      const file = e.target.files[0];\
      if (!file) return;\
      if (file.size > 3 * 1024 * 1024) \{\
        showToast("Please pick a photo smaller than 3MB");\
        return;\
      \}\
      const reader = new FileReader();\
      reader.onload = function(evt) \{\
        const img = new Image();\
        img.onload = function() \{\
          const canvas = document.createElement('canvas');\
          const maxDim = 850;\
          let width = img.width;\
          let height = img.height;\
          if (width > height && width > maxDim) \{\
            height = Math.round((height * maxDim) / width);\
            width = maxDim;\
          \} else if (height > maxDim) \{\
            width = Math.round((width * maxDim) / height);\
            height = maxDim;\
          \}\
          canvas.width = width;\
          canvas.height = height;\
          const ctx = canvas.getContext('2d');\
          ctx.drawImage(img, 0, 0, width, height);\
          const compressed = canvas.toDataURL('image/jpeg', 0.75);\
\
          if (!appData.galleryPhotos) appData.galleryPhotos = [];\
          appData.galleryPhotos.push(\{\
            id: 'photo-' + Date.now(),\
            url: compressed,\
            caption: `Memory on $\{new Date().toLocaleDateString()\}`,\
            date: new Date().toISOString().split('T')[0]\
          \});\
\
          saveStoredData(true);\
          renderHomePhotoGallery();\
          showToast("Photo added to Voyage Snaps! \uc0\u55357 \u56568 \u10024 ");\
        \};\
        img.src = evt.target.result;\
      \};\
      reader.readAsDataURL(file);\
      e.target.value = '';\
    \}\
\
    function deleteHomeGalleryPhoto(id) \{\
      if (!appData.galleryPhotos) return;\
      appData.galleryPhotos = appData.galleryPhotos.filter(p => p.id !== id);\
      saveStoredData(true);\
      renderHomePhotoGallery();\
      showToast("Photo removed from gallery!");\
    \}\
\
    function renderHomeDateInviteBanner() \{\
      const banner = document.getElementById('homeDateInviteBanner');\
      if (!appData.dateInvites || appData.dateInvites.length === 0) \{\
        banner.classList.add('hidden');\
        return;\
      \}\
\
      // Check if there is an unaccepted (pending) invite\
      const pendingInvite = appData.dateInvites.find(i => i.status === 'pending');\
      const confirmedInvites = appData.dateInvites.filter(i => i.status === 'accepted');\
\
      if (pendingInvite) \{\
        banner.classList.remove('hidden');\
        banner.innerHTML = `\
          <div onclick="openDateProposalModal('$\{pendingInvite.id\}')" class="cursor-pointer bg-gradient-to-r from-pink-500 via-rosebud-500 to-ocean-500 text-white rounded-3xl p-4 sm:p-5 shadow-md flex items-center justify-between gap-4 pulsing-border transition hover:scale-[1.01]">\
            <div class="flex items-center gap-3.5">\
              <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-xs flex items-center justify-center text-2xl">\
                \uc0\u55357 \u56460 \
              </div>\
              <div class="text-left">\
                <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/25 text-[10px] font-extrabold uppercase tracking-wide text-white mb-0.5">\
                  Action Required \'95 Date Invitation Waiting!\
                </div>\
                <h4 class="font-heading font-extrabold text-sm sm:text-base leading-tight">\
                  "$\{escapeHtml(pendingInvite.activity)\}"\
                </h4>\
                <p class="text-xs text-white/90 font-medium">\
                  Proposed for: <b>$\{pendingInvite.targetDate\}</b> \'95 Tap here to answer YES or NO!\
                </p>\
              </div>\
            </div>\
            <button class="px-4 py-2 bg-white text-pink-600 font-extrabold text-xs rounded-xl shadow-xs whitespace-nowrap">\
              Answer Now &rarr;\
            </button>\
          </div>\
        `;\
      \} else if (confirmedInvites.length > 0) \{\
        const latestConfirmed = confirmedInvites[confirmedInvites.length - 1];\
        banner.classList.remove('hidden');\
        banner.innerHTML = `\
          <div class="bg-gradient-to-r from-emerald-500/10 to-ocean-500/10 border border-emerald-200 rounded-3xl p-4 sm:p-5 flex items-center justify-between gap-3">\
            <div class="flex items-center gap-3">\
              <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold">\
                \uc0\u55358 \u56642 \
              </div>\
              <div>\
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">Official Date Confirmed!</span>\
                <h4 class="font-heading font-bold text-xs sm:text-sm text-slate-900 mt-0.5">\
                  "$\{escapeHtml(latestConfirmed.activity)\}" on $\{latestConfirmed.targetDate\}\
                </h4>\
                <p class="text-[11px] text-slate-500">Scheduled for holiday reunion time! \uc0\u10024 </p>\
              </div>\
            </div>\
            <button onclick="switchTab('dateGame')" class="text-xs font-bold text-emerald-700 hover:underline whitespace-nowrap">\
              Plan Another Date &rarr;\
            </button>\
          </div>\
        `;\
      \} else \{\
        banner.classList.add('hidden');\
      \}\
    \}\
\
    function switchTab(tabKey) \{\
      const tabs = ['home', 'diary', 'letters', 'dateGame', 'ideas'];\
      tabs.forEach(key => \{\
        const view = document.getElementById(`view-$\{key\}`);\
        const btn = document.getElementById(`tabBtn-$\{key\}`);\
        if (key === tabKey) \{\
          view.classList.remove('hidden');\
          btn.className = "px-3.5 py-1.5 rounded-full text-xs font-bold transition bg-gradient-to-r from-pink-500 to-ocean-500 text-white shadow-xs whitespace-nowrap";\
        \} else \{\
          view.classList.add('hidden');\
          btn.className = "px-3.5 py-1.5 rounded-full text-xs font-bold transition text-slate-600 hover:text-pink-600 hover:bg-pink-50 whitespace-nowrap";\
        \}\
      \});\
\
      if (tabKey === 'diary') renderDiary();\
      if (tabKey === 'letters') renderNotes();\
      if (tabKey === 'dateGame') renderDateMeTab();\
      if (tabKey === 'ideas') renderIdeas();\
    \}\
\
    let checkInStep = 1;\
    let currentCheckInDraft = \{\
      step: 1,\
      mood: 'Cruising on good vibes \uc0\u10024 ',\
      missScale: 5,\
      missDesc: 'Ready to swim back across the ocean',\
      questionPrompt: '',\
      questionAnswer: '',\
      photoData: '',\
      message: ''\
    \};\
\
    function saveCheckInDraft() \{\
      currentCheckInDraft.step = checkInStep;\
      currentCheckInDraft.questionAnswer = document.getElementById('checkInQuestionAnswer').value;\
      currentCheckInDraft.message = document.getElementById('checkInMessageText').value;\
      try \{\
        localStorage.setItem(getDraftKey(), JSON.stringify(currentCheckInDraft));\
      \} catch (e) \{\
        console.error('Draft save failed:', e);\
      \}\
    \}\
\
    function clearCurrentDraft() \{\
      localStorage.removeItem(getDraftKey());\
      document.getElementById('draftRestoredBanner').classList.add('hidden');\
      const metrics = getRotationMetrics();\
      const prompt = getPromptForDay(metrics.currentDay);\
      currentCheckInDraft = \{\
        step: 1,\
        mood: 'Cruising on good vibes \uc0\u10024 ',\
        missScale: 5,\
        missDesc: 'Ready to swim back across the ocean right now',\
        questionPrompt: prompt,\
        questionAnswer: '',\
        photoData: '',\
        message: ''\
      \};\
      document.getElementById('checkInQuestionAnswer').value = '';\
      document.getElementById('checkInMessageText').value = '';\
      document.getElementById('customMoodInput').value = '';\
      document.getElementById('missSlider').value = 5;\
      handleMissSliderChange(5, false);\
      clearSelectedPhoto();\
      showCheckInStepUI(1);\
      showToast("Draft cleared! Starting fresh \uc0\u55358 \u56825 ");\
    \}\
\
    function startDailyCheckIn() \{\
      const metrics = getRotationMetrics();\
      const prompt = getPromptForDay(metrics.currentDay);\
      \
      const rawDraft = localStorage.getItem(getDraftKey());\
      let restoredFromDraft = false;\
\
      if (rawDraft) \{\
        try \{\
          const parsed = JSON.parse(rawDraft);\
          if (parsed) \{\
            currentCheckInDraft = parsed;\
            restoredFromDraft = true;\
          \}\
        \} catch (e) \{\}\
      \}\
\
      if (!restoredFromDraft) \{\
        currentCheckInDraft = \{\
          step: 1,\
          mood: 'Cruising on good vibes \uc0\u10024 ',\
          missScale: 5,\
          missDesc: 'Ready to swim back across the ocean right now',\
          questionPrompt: prompt,\
          questionAnswer: '',\
          photoData: '',\
          message: ''\
        \};\
      \}\
\
      document.getElementById('checkInModalDayHeader').innerText = `Day $\{metrics.currentDay\} of $\{metrics.totalDays\}`;\
      document.getElementById('checkInQuestionDayTag').innerText = `Day $\{metrics.currentDay\} Prompt:`;\
      document.getElementById('checkInQuestionPromptText').innerText = currentCheckInDraft.questionPrompt || prompt;\
      document.getElementById('checkInQuestionAnswer').value = currentCheckInDraft.questionAnswer || '';\
      document.getElementById('checkInMessageText').value = currentCheckInDraft.message || '';\
      document.getElementById('missSlider').value = currentCheckInDraft.missScale || 5;\
      handleMissSliderChange(currentCheckInDraft.missScale || 5, false);\
\
      // Handle custom mood input recovery\
      const customMoodEl = document.getElementById('customMoodInput');\
      if (customMoodEl) \{\
        const standardMoods = [\
          'Surviving on boat coffee \uc0\u9749 ',\
          'Cruising on good vibes \uc0\u10024 ',\
          'Shift was crazy busy \uc0\u55356 \u57098 ',\
          'Cozy cabin chill \uc0\u55356 \u57255 ',\
          'Productive & strong shift \uc0\u9875 ',\
          'Ready for bed & bunk \uc0\u55357 \u57036 '\
        ];\
        if (currentCheckInDraft.mood && !standardMoods.includes(currentCheckInDraft.mood)) \{\
          customMoodEl.value = currentCheckInDraft.mood;\
        \} else \{\
          customMoodEl.value = '';\
